{
  "name": "next5-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:migrate": "dbmate up",
    "db:rollback": "dbmate down",
    "db:status": "dbmate status",
    "db:seed": "tsx -r dotenv/config scripts/seed-prompts.ts dotenv_config_path=.env.local",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "generate": "prisma generate",
    "db:seed:business": "tsx scripts/seed-business.ts",
    "db:seed:templates": "tsx -r dotenv/config scripts/seed-content-templates.ts dotenv_config_path=.env.local",
    "acceptance:templates": "tsx -r dotenv/config scripts/acceptance-content-plan.ts dotenv_config_path=.env.local",
    "db:seed:blitz": "tsx -r dotenv/config scripts/seed-blitz.ts dotenv_config_path=.env.local",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/brand.mjs && node tests/e2e/shop.mjs && node tests/e2e/brand-create.mjs && node tests/e2e/shop-app.mjs",
    "test:e2e:early": "node tests/e2e/early-access.mjs",
    "worker:blitz": "cd blitz-worker && node_modules/.bin/tsx src/index.ts",
    "test:e2e:blitz": "E2E_ADMIN_SECRET=$ADMIN_SECRET node tests/e2e/blitz-render.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@dnd-kit/core": "^6.3.1",
    "@google/genai": "^2.24.0",
    "@prisma/client": "^6.19.3",
    "@remotion/effects": "^4.0.526",
    "@remotion/google-fonts": "4.0.526",
    "@remotion/media": "^4.0.526",
    "@remotion/player": "^4.0.526",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.9",
    "ffmpeg-static": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.35.0",
    "next": "16.3.2",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^9.3.10",
    "remotion": "^4.0.526",
    "resend": "^6.25.0",
    "sharp": "^0.35.4",
    "tinify": "^1.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dbmate": "^2.35.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "playwright": "1.61",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}

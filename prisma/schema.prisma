generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  pending
  paid
  confirmed
}

enum ShootStatus {
  preview_generating
  preview_ready
  creating
  delivered
  error
}

enum PhotoType {
  upload
  preview
  generated
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  /** Claimed from the studio-reveal upsell. Null percent = no active offer. */
  activeOfferPercent  Int?     @map("active_offer_percent")
  activeOfferLabel    String?  @map("active_offer_label")
  activeOfferRouteIds String[] @default([]) @map("active_offer_route_ids")

  bookings Booking[]
  photos   Photo[]

  @@map("users")
}

model Prompt {
  id         String   @id @default(cuid())
  routeId    String   @map("route_id")
  sceneIndex Int      @map("scene_index")
  prompt     String
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([routeId, sceneIndex])
  @@index([routeId])
  @@map("prompts")
}

model Booking {
  id              String        @id
  userId          String?       @map("user_id")
  routeId         String        @map("route_id")
  routeTitle      String        @map("route_title")
  directorId      String        @default("") @map("director_id")
  directorName    String        @default("") @map("director_name")
  feelings        String[]
  goals           String[]
  amountVnd       Int?          @map("amount_vnd")
  discountPercent Int?          @map("discount_percent")
  paymentStatus   PaymentStatus @default(pending) @map("payment_status")
  shootStatus     ShootStatus   @default(preview_generating) @map("shoot_status")
  wavespeedTaskId String?       @map("wavespeed_task_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  /** Regeneration tracking — players can request up to 2 regenerations per booking within 24 h. */
  regenerateCount  Int       @default(0) @map("regenerate_count")
  regenerateLastAt DateTime? @map("regenerate_last_at")

  user   User?   @relation(fields: [userId], references: [id])
  photos Photo[]

  @@index([userId])
  @@index([wavespeedTaskId])
  @@map("bookings")
}

model Photo {
  id           String    @id @default(cuid())
  bookingId    String    @map("booking_id")
  userId       String?   @map("user_id")
  type         PhotoType
  sceneIndex   Int?      @map("scene_index")
  r2Key        String?   @map("r2_key")
  wavespeedUrl String?   @map("wavespeed_url")
  isStored     Boolean   @default(false) @map("is_stored")
  createdAt    DateTime  @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([bookingId])
  @@index([userId])
  @@map("photos")
}

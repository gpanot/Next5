generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  pending
  paid
  confirmed
}

enum ShootStatus {
  preview_generating
  preview_ready
  creating
  delivered
  error
}

enum PhotoType {
  upload
  preview
  generated
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  /**
   * Claimed from the studio-reveal upsell. Null percent = no active offer.
   */
  activeOfferPercent  Int?     @map("active_offer_percent")
  activeOfferLabel    String?  @map("active_offer_label")
  activeOfferRouteIds String[] @default([]) @map("active_offer_route_ids")

  bookings Booking[]
  photos   Photo[]

  // Business studios (Brand / Shop)
  workspaces Workspace[]
  consents   ConsentRecord[]
  payments   Payment[]

  @@map("users")
}

model Prompt {
  id         String   @id @default(cuid())
  routeId    String   @map("route_id")
  sceneIndex Int      @map("scene_index")
  prompt     String
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([routeId, sceneIndex])
  @@index([routeId])
  @@map("prompts")
}

model Booking {
  id              String        @id
  userId          String?       @map("user_id")
  routeId         String        @map("route_id")
  routeTitle      String        @map("route_title")
  directorId      String        @default("") @map("director_id")
  directorName    String        @default("") @map("director_name")
  feelings        String[]
  goals           String[]
  amountVnd       Int?          @map("amount_vnd")
  discountPercent Int?          @map("discount_percent")
  paymentStatus   PaymentStatus @default(pending) @map("payment_status")
  shootStatus     ShootStatus   @default(preview_generating) @map("shoot_status")
  wavespeedTaskId String?       @map("wavespeed_task_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  /**
   * Regeneration tracking — players can request up to 2 regenerations per booking within 24 h.
   */
  regenerateCount  Int       @default(0) @map("regenerate_count")
  regenerateLastAt DateTime? @map("regenerate_last_at")

  /**
   * Preview feedback — captured on the first-shot preview screen.
   */
  previewFeedback       String? @map("preview_feedback")
  previewFeedbackDetail String? @map("preview_feedback_detail")

  user          User?                 @relation(fields: [userId], references: [id])
  photos        Photo[]
  regenerations BookingRegeneration[]

  @@index([userId])
  @@index([wavespeedTaskId])
  @@map("bookings")
}

model Photo {
  id           String    @id @default(cuid())
  bookingId    String    @map("booking_id")
  userId       String?   @map("user_id")
  type         PhotoType
  sceneIndex   Int?      @map("scene_index")
  r2Key        String?   @map("r2_key")
  wavespeedUrl String?   @map("wavespeed_url")
  isStored     Boolean   @default(false) @map("is_stored")
  createdAt    DateTime  @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([bookingId])
  @@index([userId])
  @@map("photos")
}

model BookingRegeneration {
  id         String   @id @default(cuid())
  bookingId  String   @map("booking_id")
  sceneIndex Int?     @map("scene_index")
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_regenerations")
}

// ════════════════════════════════════════════════════════════════════════════
// Business studios — Next5 Brand + Next5 Shop
// Spec: docs/business-studios/02-architecture.md §4
// ════════════════════════════════════════════════════════════════════════════

enum ProductLine {
  brand
  shop
}

enum IdentityKind {
  face
  full_body
}

enum SetStatus {
  draft
  active
  archived
}

enum BatchKind {
  trial
  brand_theme
  shop_products
}

enum BatchStatus {
  queued
  generating
  ready
  failed
  cancelled
}

enum ItemStatus {
  queued
  submitting
  generating
  ready
  failed
}

enum SubscriptionStatus {
  pending
  active
  expired
  cancelled
}

enum PaymentPurpose {
  subscription
  topup
  consumer_booking
}

enum PaymentState {
  pending
  paid
  underpaid
  expired
  refunded
}

enum LedgerReason {
  trial_grant
  plan_grant
  topup_grant
  batch_reserve
  item_refund
  redo_charge
  expiry
  admin_adjust
}

model Workspace {
  id                    String        @id @default(cuid())
  ownerUserId           String        @map("owner_user_id")
  product               ProductLine
  name                  String
  industry              String?
  handle                String?
  brandColors           String[]      @default([]) @map("brand_colors")
  visibleAiTag          Boolean       @default(false) @map("visible_ai_tag")
  defaultFormats        String[]      @default([]) @map("default_formats")
  trialUsedAt           DateTime?     @map("trial_used_at")
  onboardingStep        Int           @default(0) @map("onboarding_step")
  onboardingCompletedAt DateTime?     @map("onboarding_completed_at")
  // B2B onboarding qualification fields
  teamSize              String?       @map("team_size")
  monthlyRevenue        String?       @map("monthly_revenue")
  obRole                String?       @map("ob_role")
  signupIntent          String?       @map("signup_intent")
  goals                 String[]      @default([])
  attribution           String[]      @default([])
  // Brand intelligence — extracted from the business website
  websiteUrl            String?       @map("website_url")
  /// "never" | "rarely" | "sometimes" | "often" | "always"
  mentionFrequency      String        @default("sometimes") @map("mention_frequency")
  /// null = all, "men" | "women"
  genderFilter          String?       @map("gender_filter")
  /// "idle" | "pending" | "done" | "failed"
  anglesGenState        String        @default("idle") @map("angles_gen_state")
  anglesGenAt           DateTime?     @map("angles_gen_at")
  // Phase 0B — what the Template Engine needs to know about the business
  /// Who she sells to. Asked at signup step 2, editable on the Brand page.
  audienceType          AudienceType? @map("audience_type")
  /// One line: what the business or product is.
  promoting             String?
  /// One line: the core value proposition.
  offer                 String?
  positioning           String?
  geography             String?
  /// Rich brand profile extracted from the website (JSON blob). Shape: BrandExtractData in me.ts.
  brandExtract          Json?         @map("brand_extract")
  brandExtractAt        DateTime?     @map("brand_extract_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  owner             User                @relation(fields: [ownerUserId], references: [id])
  identities        IdentityReference[]
  sets              StudioSet[]
  influencers       Influencer[]
  products          Product[]
  batches           Batch[]
  subscriptions     Subscription[]
  ledger            CreditLedger[]
  payments          Payment[]
  promiseClaims     PromiseClaim[]
  shopConnections   ShopConnection[]
  listingPacks      ListingPack[]
  dropSchedule      DropSchedule?
  postSchedule      PostSchedule?
  postMaterials     PostMaterial[]
  postSlots         PostSlot[]
  listings          Listing[]
  socialConnections SocialConnection[]
  socialPosts       SocialPost[]
  angles            WorkspaceAngle[]
  contentTemplates  ContentTemplate[]
  templateUsages    TemplateUsage[]
  campaigns         Campaign[]
  ugcCharacters     UgcCharacter[]
  ugcVideos         UgcVideo[]
  cloneVideos       CloneVideo[]
  blitzAssets       BlitzAsset[]
  blitzProjects     BlitzProject[]
  studioBrandProfiles StudioBrandProfile[]
  studioRuns          StudioRun[]
  assetDescriptors    AssetDescriptor[]

  @@unique([ownerUserId, product])
  @@map("workspaces")
}

/// A content angle (customer pain point) used to generate blitz card text overlays.
model WorkspaceAngle {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Short label, 3-7 words, e.g. "Missed Calls, Lost Jobs"
  label       String    @db.VarChar(100)
  /// 0-100; all angles in a workspace should sum to ~100
  weight      Int       @default(33)
  /// Display order (0-based)
  position    Int       @default(0)
  /// "ai" = extracted from website | "user" = manually added
  source      String    @default("ai")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("workspace_angles")
}

model IdentityReference {
  id              String       @id @default(cuid())
  workspaceId     String?      @map("workspace_id")
  kind            IdentityKind
  r2Key           String       @map("r2_key")
  isStudioModel   Boolean      @default(false) @map("is_studio_model")
  studioModelSlug String?      @map("studio_model_slug")
  wavespeedUrl    String?      @map("wavespeed_url")
  wavespeedUrlAt  DateTime?    @map("wavespeed_url_at")
  deletedAt       DateTime?    @map("deleted_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([studioModelSlug])
  @@map("identity_references")
}

model ConsentRecord {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  type       String
  version    String
  ip         String?
  userAgent  String?  @map("user_agent")
  acceptedAt DateTime @default(now()) @map("accepted_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("consent_records")
}

model SetTemplate {
  id          String      @id
  product     ProductLine
  name        String
  description String
  coverImage  String      @map("cover_image")
  config      Json
  sortOrder   Int         @default(0) @map("sort_order")
  isActive    Boolean     @default(true) @map("is_active")

  sets StudioSet[]

  @@map("set_templates")
}

model StudioSet {
  id           String    @id @default(cuid())
  workspaceId  String    @map("workspace_id")
  templateId   String    @map("template_id")
  name         String
  locations    String[]
  wardrobe     String?
  poseEnergy   String?   @map("pose_energy")
  brandColors  String[]  @default([]) @map("brand_colors")
  modelRef     String?   @map("model_ref")
  status       SetStatus @default(active)
  coverR2Key   String?   @map("cover_r2_key")
  /// FK to the Influencer that auto-created this set (null for user-created sets).
  influencerId String?   @map("influencer_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace  Workspace   @relation(fields: [workspaceId], references: [id])
  template   SetTemplate @relation(fields: [templateId], references: [id])
  batches    Batch[]
  influencer Influencer? @relation(fields: [influencerId], references: [id])

  @@index([workspaceId])
  @@index([influencerId])
  @@map("studio_sets")
}

/// Admin-curated pre-made AI faces for the influencer gallery picker.
model InfluencerGalleryItem {
  id        String   @id @default(cuid())
  imageKey  String   @map("image_key")
  gender    String?
  age       Int?
  ethnicity String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  influencers Influencer[]

  @@map("influencer_gallery_items")
}

/// A named AI influencer: 1 base portrait + the sets auto-generated from it.
model Influencer {
  id                 String   @id @default(cuid())
  workspaceId        String   @map("workspace_id")
  name               String   @db.VarChar(80)
  gender             String?
  age                Int?
  ethnicity          String?
  /// "generated" | "uploaded" | "gallery"
  source             String
  /// R2 key for the one base portrait (null while still generating).
  baseImageKey       String?  @map("base_image_key")
  /// FK when source = "gallery".
  galleryItemId      String?  @map("gallery_item_id")
  /// "active" | "archived"
  status             String   @default("active")
  /// Locked identity JSON (portrait-clone) read once from the base portrait; reused by every Gemini prompt.
  identityLock       Json?    @map("identity_lock")
  /// Full portrait-clone prompt JSON used to generate the base portrait (null for uploaded/gallery sources).
  /// Preserved so future video-generation pipelines can re-use the original specification instead of
  /// working from the image.
  portraitPromptJson Json?    @map("portrait_prompt_json")
  createdAt          DateTime @default(now()) @map("created_at")

  workspace   Workspace              @relation(fields: [workspaceId], references: [id])
  galleryItem InfluencerGalleryItem? @relation(fields: [galleryItemId], references: [id])
  sets        StudioSet[]

  @@index([workspaceId])
  @@map("influencers")
}

model Theme {
  id            String  @id
  title         String
  description   String
  coverImage    String  @map("cover_image")
  scenes        Json
  featuredMonth String? @map("featured_month")
  isActive      Boolean @default(true) @map("is_active")
  sortOrder     Int     @default(0) @map("sort_order")

  batches Batch[]

  @@map("themes")
}

model Product {
  id               String    @id @default(cuid())
  workspaceId      String    @map("workspace_id")
  name             String
  category         String
  colorName        String?   @map("color_name")
  sku              String?
  fit              String?
  notes            String?
  frontR2Key       String    @map("front_r2_key")
  backR2Key        String?   @map("back_r2_key")
  detailR2Key      String?   @map("detail_r2_key")
  /// upload | tiktok_scrape | tiktok_export | tiktok_api
  source           String    @default("upload")
  externalId       String?   @map("external_id")
  externalUrl      String?   @map("external_url")
  categoryPath     String?   @map("category_path")
  description      String?
  /// Shop Post Kit for the whole listing (all photos of this product); generated on demand, cached.
  postKit          Json?     @map("post_kit")
  priceCents       Int?      @map("price_cents")
  currency         String?
  soldCount        Int?      @map("sold_count")
  imageUrls        String[]  @default([]) @map("image_urls")
  /// The listing image used as the product reference (downloaded to frontR2Key).
  frontImageUrl    String?   @map("front_image_url")
  /// [{ id, name, color, size, priceCents, stock, imageUrl }]
  variants         Json?
  specifications   Json?
  detailsFetchedAt DateTime? @map("details_fetched_at")
  importedAt       DateTime? @map("imported_at")
  lastSyncedAt     DateTime? @map("last_synced_at")
  lastUsedAt       DateTime? @map("last_used_at")
  archivedAt       DateTime? @map("archived_at")
  /// The seller archived it by hand: a store sync must not bring it back.
  archivedBySeller Boolean   @default(false) @map("archived_by_seller")
  createdAt        DateTime  @default(now()) @map("created_at")

  workspace   Workspace         @relation(fields: [workspaceId], references: [id])
  items       BatchItem[]
  snapshots   ProductSnapshot[]
  postSlots   PostSlot[]
  listingPack ListingPack?
  campaigns   Campaign[]

  @@unique([workspaceId, source, externalId])
  @@index([workspaceId])
  @@map("products")
}

model Batch {
  id              String      @id @default(cuid())
  workspaceId     String      @map("workspace_id")
  kind            BatchKind
  status          BatchStatus @default(queued)
  name            String
  setId           String?     @map("set_id")
  themeId         String?     @map("theme_id")
  packId          String?     @map("pack_id")
  formats         String[]
  highRes         Boolean     @default(false) @map("high_res")
  priority        Int         @default(2)
  creditsReserved Int         @default(0) @map("credits_reserved")
  costUsdMicros   Int         @default(0) @map("cost_usd_micros")
  /// Set when the batch was built from one property's photos.
  listingId       String?     @map("listing_id")
  /// Property batches: coming_soon | just_listed | for_sale | open_house | under_contract | just_sold.
  occasion        String?
  /// Free "preview on me" photos for one style; kept out of the library, batch list and calendar.
  preview         Boolean     @default(false)
  /// Influencer variations (Influencers page): face images reused in Create; kept out of the library, batch list and calendar.
  variation       Boolean     @default(false)
  createdAt       DateTime    @default(now()) @map("created_at")
  completedAt     DateTime?   @map("completed_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id])
  set       StudioSet?  @relation(fields: [setId], references: [id])
  theme     Theme?      @relation(fields: [themeId], references: [id])
  listing   Listing?    @relation(fields: [listingId], references: [id])
  items     BatchItem[]

  @@index([workspaceId, createdAt])
  @@index([setId, preview])
  @@map("batches")
}

model BatchItem {
  id               String     @id @default(cuid())
  batchId          String     @map("batch_id")
  productId        String?    @map("product_id")
  sceneId          String?    @map("scene_id")
  shot             String?
  format           String
  prompt           String
  inputR2Keys      String[]   @map("input_r2_keys")
  status           ItemStatus @default(queued)
  attempts         Int        @default(0)
  wavespeedTaskId  String?    @map("wavespeed_task_id")
  r2Key            String?    @map("r2_key")
  errorMessage     String?    @map("error_message")
  /// Image model for the current run: null = nano-banana-2, "gpt-image-2" after the fallback retry.
  model            String?
  freeRedosUsed    Int        @default(0) @map("free_redos_used")
  redoReason       String?    @map("redo_reason")
  /// Refund key for the current run when it was paid; null for free redos.
  pendingRefundKey String?    @map("pending_refund_key")
  favorite         Boolean    @default(false)
  rating           Int?
  caption          String?
  /// Post Kit: { hook, caption, hashtags[], description? } — generated on demand, cached.
  postKit          Json?      @map("post_kit")
  /// Scroll-Stop Score 0–100 from the vision rubric (src/server/score).
  score            Int?
  scoreDetails     Json?      @map("score_details")
  /// The drop-box material this photo was built from, so a slot can show "24 Oak St".
  materialId       String?    @map("material_id")
  /// She archived it (trash icon): hidden from the batch, library, zips and calendar.
  archivedAt       DateTime?  @map("archived_at")
  submittedAt      DateTime?  @map("submitted_at")
  completedAt      DateTime?  @map("completed_at")
  createdAt        DateTime   @default(now()) @map("created_at")

  batch    Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  product  Product?      @relation(fields: [productId], references: [id])
  material PostMaterial? @relation(fields: [materialId], references: [id])
  slots    PostSlot[]

  @@index([batchId])
  @@index([status, createdAt])
  @@index([wavespeedTaskId])
  @@map("batch_items")
}

model Subscription {
  id           String             @id @default(cuid())
  workspaceId  String             @map("workspace_id")
  planId       String             @map("plan_id")
  termMonths   Int                @map("term_months")
  status       SubscriptionStatus @default(pending)
  startsAt     DateTime?          @map("starts_at")
  endsAt       DateTime?          @map("ends_at")
  nextGrantAt  DateTime?          @map("next_grant_at")
  grantsIssued Int                @default(0) @map("grants_issued")
  paymentId    String?            @unique @map("payment_id")
  createdAt    DateTime           @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, status])
  @@index([nextGrantAt])
  @@map("subscriptions")
}

model CreditLedger {
  id          String       @id @default(cuid())
  workspaceId String       @map("workspace_id")
  delta       Int
  reason      LedgerReason
  bucket      String
  grantId     String?      @map("grant_id")
  refType     String?      @map("ref_type")
  refId       String?      @map("ref_id")
  expiresAt   DateTime?    @map("expires_at")
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([reason, bucket, refType, refId, grantId])
  @@index([workspaceId, createdAt])
  @@index([grantId])
  @@map("credit_ledger")
}

model Payment {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  workspaceId    String?        @map("workspace_id")
  bookingId      String?        @map("booking_id")
  purpose        PaymentPurpose
  itemId         String         @map("item_id")
  amountUsdCents Int?           @map("amount_usd_cents")
  amountVnd      Int            @map("amount_vnd")
  fxVndPerUsd    Int?           @map("fx_vnd_per_usd")
  reference      String         @unique
  provider       String         @default("mock")
  state          PaymentState   @default(pending)
  paidVnd        Int?           @map("paid_vnd")
  expiresAt      DateTime       @map("expires_at")
  paidAt         DateTime?      @map("paid_at")
  fulfilledAt    DateTime?      @map("fulfilled_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("payments")
}

model BankTransaction {
  id            String   @id @default(cuid())
  provider      String   @default("sepay")
  providerTxnId String   @map("provider_txn_id")
  amountVnd     Int      @map("amount_vnd")
  content       String
  reference     String?
  paymentId     String?  @map("payment_id")
  matchStatus   String   @map("match_status")
  raw           Json
  receivedAt    DateTime @default(now()) @map("received_at")

  @@unique([provider, providerTxnId])
  @@index([matchStatus])
  @@map("bank_transactions")
}

model EmailLog {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  workspaceId String?   @map("workspace_id")
  template    String
  dedupeKey   String    @unique @map("dedupe_key")
  sentAt      DateTime? @map("sent_at")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_logs")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([targetType, targetId], map: "admin_audit_logs_target_idx")
  @@map("admin_audit_logs")
}

model RateLimit {
  key         String
  windowStart DateTime @map("window_start")
  count       Int      @default(0)

  @@id([key, windowStart])
  @@map("rate_limits")
}

/// "Beat your feed" promise claim: the customer compares her Next5 posts with her earlier posts (self-reported).
model PromiseClaim {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  userId          String    @map("user_id")
  platform        String
  /// likes | views | saves | clicks
  metric          String
  beforeAverage   Int       @map("before_average")
  afterAverage    Int       @map("after_average")
  postsCounted    Int       @map("posts_counted")
  links           String[]  @default([])
  note            String?
  sharePermission Boolean   @default(false) @map("share_permission")
  /// pending | granted | declined
  status          String    @default("pending")
  /// won (Next5 posts did better) | missed (free month owed)
  outcome         String
  adminNote       String?   @map("admin_note")
  decidedAt       DateTime? @map("decided_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status, createdAt])
  @@map("promise_claims")
}

/// A seller's store connected to Shop Studio (V1: public scrape or Seller Center export; later the TikTok Shop API).
model ShopConnection {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  platform        String    @default("tiktok_shop")
  /// scrape | export | api
  source          String
  shopUrl         String?   @map("shop_url")
  externalShopId  String?   @map("external_shop_id")
  shopName        String?   @map("shop_name")
  shopLogoUrl     String?   @map("shop_logo_url")
  /// pending | syncing | ready | failed
  status          String    @default("pending")
  runId           String?   @map("run_id")
  productCount    Int       @default(0) @map("product_count")
  totalSold       Int?      @map("total_sold")
  lastSyncedAt    DateTime? @map("last_synced_at")
  nextSyncAt      DateTime? @map("next_sync_at")
  error           String?
  ownerAttestedAt DateTime? @map("owner_attested_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform])
  @@index([status, nextSyncAt])
  @@map("shop_connections")
}

/// Sold count / price over time — the before/after baseline for imported products.
model ProductSnapshot {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  soldCount  Int?     @map("sold_count")
  priceCents Int?     @map("price_cents")
  capturedAt DateTime @default(now()) @map("captured_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, capturedAt])
  @@map("product_snapshots")
}

/// A product's TikTok Shop listing pack: up to 9 photos in upload order plus a 9:16 cover. Only saved once the seller edits it.
model ListingPack {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  productId     String    @unique @map("product_id")
  /// draft | ready | uploaded
  status        String    @default("draft")
  slotItemIds   String[]  @default([]) @map("slot_item_ids")
  hiddenItemIds String[]  @default([]) @map("hidden_item_ids")
  coverItemId   String?   @map("cover_item_id")
  uploadedAt    DateTime? @map("uploaded_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("listing_packs")
}

/// Shop Growth/Scale: every week (or two) we pick products that need photos and email a drop to review. Never spends credits by itself.
model DropSchedule {
  id              String    @id @default(cuid())
  workspaceId     String    @unique @map("workspace_id")
  active          Boolean   @default(true)
  /// weekly | biweekly
  cadence         String    @default("weekly")
  /// 0 = Sunday … 6 = Saturday (UTC)
  weekday         Int       @default(1)
  productsPerDrop Int       @default(10) @map("products_per_drop")
  setId           String?   @map("set_id")
  packId          String    @default("listing") @map("pack_id")
  formats         String[]  @default(["square_1_1", "story_9_16"])
  nextRunAt       DateTime? @map("next_run_at")
  lastRunAt       DateTime? @map("last_run_at")
  lastProductIds  String[]  @default([]) @map("last_product_ids")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([active, nextRunAt])
  @@map("drop_schedules")
}

/// Admin model bench: one product prompt run through several image models.
model ModelTestRun {
  id          String   @id @default(cuid())
  label       String?
  prompt      String
  shot        String
  format      String
  resolution  String   @default("1k")
  templateId  String?  @map("template_id")
  modelRef    String?  @map("model_ref")
  productName String?  @map("product_name")
  inputR2Keys String[] @map("input_r2_keys")
  createdAt   DateTime @default(now()) @map("created_at")

  items ModelTestItem[]

  @@map("model_test_runs")
}

model ModelTestItem {
  id              String    @id @default(cuid())
  runId           String    @map("run_id")
  /// Image model id from src/config/imageModels.ts.
  model           String
  /// generating | ready | failed
  status          String    @default("generating")
  wavespeedTaskId String?   @map("wavespeed_task_id")
  r2Key           String?   @map("r2_key")
  error           String?
  costUsdMicros   Int       @default(0) @map("cost_usd_micros")
  submittedAt     DateTime? @map("submitted_at")
  completedAt     DateTime? @map("completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  run ModelTestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("model_test_items")
}

/// Brand Studio calendar: her posting cadence, and the autopilot that keeps it stocked.
model PostSchedule {
  id              String    @id @default(cuid())
  workspaceId     String    @unique @map("workspace_id")
  active          Boolean   @default(true)
  /// 0-6, Sunday = 0. Default Tue/Thu/Sat — 12 posts a month, the promise threshold.
  weekdays        Int[]     @default([2, 4, 6])
  /// IANA zone, read from the browser on first save.
  timezone        String    @default("UTC")
  /// Place finished photos into open slots.
  autoFill        Boolean   @default(true) @map("auto_fill")
  /// Generate on her behalf. Off until her first manual batch (docs 11-calendar-plan §5.8).
  autopilot       Boolean   @default(false)
  /// How far ahead autopilot keeps her stocked.
  bufferDays      Int       @default(14) @map("buffer_days")
  weeklyDigest    Boolean   @default(true) @map("weekly_digest")
  icsToken        String    @unique @map("ics_token")
  lastFilledAt    DateTime? @map("last_filled_at")
  lastGeneratedAt DateTime? @map("last_generated_at")
  /// Autopilot stopped because nothing has been posted in a fortnight — the churn alarm.
  pausedAt        DateTime? @map("paused_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slots     PostSlot[]

  @@map("post_schedules")
}

/// The drop box: her own photos (a listing, a treatment room) that we put her into.
model PostMaterial {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  r2Key       String    @map("r2_key")
  /// listing | room | other
  kind        String    @default("listing")
  label       String?
  note        String?
  /// The property this photo belongs to. Null for loose brand material.
  listingId   String?   @map("listing_id")
  /// The Zillow photo this was imported from. Null for her own uploads.
  sourceUrl   String?   @map("source_url")
  width       Int?
  height      Int?
  /// Room type from the import tagger (kitchen, exterior…). Used for preselecting and the prompt label.
  tag         String?
  usedAt      DateTime? @map("used_at")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  listing   Listing?    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  slots     PostSlot[]
  items     BatchItem[]

  @@index([workspaceId, createdAt])
  @@map("post_materials")
}

/// One dated post. The photo is optional until autopilot or auto-fill lands one in it.
model PostSlot {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  scheduleId      String?   @map("schedule_id")
  scheduledFor    DateTime  @map("scheduled_for") @db.Date
  /// morning | midday | evening
  slotOfDay       String    @default("evening") @map("slot_of_day")
  itemId          String?   @map("item_id")
  materialId      String?   @map("material_id")
  /// Reserved for a Shop calendar; unused in P19.
  productId       String?   @map("product_id")
  platform        String    @default("instagram")
  /// planned | posted | skipped
  status          String    @default("planned")
  postUrl         String?   @map("post_url")
  postedAt        DateTime? @map("posted_at")
  captionOverride String?   @map("caption_override")
  /// auto | manual | drop | campaign
  source          String    @default("auto")
  /// Set when this slot belongs to a campaign. One campaign post owns one slot per channel.
  campaignPostId  String?   @map("campaign_post_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  schedule     PostSchedule? @relation(fields: [scheduleId], references: [id])
  item         BatchItem?    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  material     PostMaterial? @relation(fields: [materialId], references: [id])
  campaignPost CampaignPost? @relation(fields: [campaignPostId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id])
  socialPosts  SocialPost[]

  @@unique([workspaceId, itemId])
  @@index([workspaceId, scheduledFor])
  @@index([workspaceId, status, postedAt])
  @@index([itemId])
  @@index([campaignPostId])
  @@map("post_slots")
}

/// A property she represents. Photos of it are grouped so a batch is built only
/// from rooms she gave us — we never invent a room (docs/business-studios/12-listing-mode-plan.md).
model Listing {
  id           String    @id @default(cuid())
  workspaceId  String    @map("workspace_id")
  label        String
  /// She confirmed she represents this property (a self-declaration).
  attestedAt   DateTime? @map("attested_at")
  /// Off by default; visible-label rules differ by state and MLS, so it is her call.
  visibleAiTag Boolean   @default(false) @map("visible_ai_tag")
  /// upload | zillow (docs/business-studios/13-zillow-import-plan.md)
  source       String    @default("upload")
  zpid         String?
  sourceUrl    String?   @map("source_url")
  /// { street, city, state, zip, full }
  address      Json?
  priceCents   Int?      @map("price_cents")
  beds         Int?
  baths        Float?
  sqft         Int?
  /// coming_soon | just_listed | for_sale | open_house | pending | sold | off_market
  status       String?
  daysOnMarket Int?      @map("days_on_market")
  /// Every photo of the Zillow gallery: { id, url, thumbUrl, tag }[]
  candidates   Json?
  /// fetching | failed while importing; ready once the photos are in
  importStatus String    @default("ready") @map("import_status")
  importError  String?   @map("import_error")
  runId        String?   @map("run_id")
  importedAt   DateTime? @map("imported_at")
  syncedAt     DateTime? @map("synced_at")
  archivedAt   DateTime? @map("archived_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  materials PostMaterial[]
  batches   Batch[]
  campaigns Campaign[]

  @@unique([workspaceId, zpid])
  @@index([workspaceId, createdAt])
  @@index([runId])
  @@map("listings")
}

/// UGC Lab: a saved on-screen character — an AI portrait or an uploaded photo (cropped to 9:16).
model UgcCharacter {
  id           String   @id @default(cuid())
  /// Which workspace owns this row. Null = owned by Next5 and visible to every workspace
  /// (the admin labs and the seeded library). Set = private to one workspace.
  workspaceId  String?  @map("workspace_id")
  /// ai | photo | avatar
  kind         String
  imageKey     String   @map("image_key")
  /// Image model for AI portraits, e.g. gemini-3-pro.
  model        String?
  /// Photo kind: what the photo shows — { person, setting, action, shot }.
  scene        Json?
  /// Avatar kind: portrait-clone JSON locking every visual attribute for consistent Seedance prompts.
  portraitJson Json?    @map("portrait_json")
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")

  videos    UgcVideo[]
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([kind, archived])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("ugc_characters")
}

/// UGC Lab: one Seedance talking-head video. Files live in R2; provider URLs are never stored.
model UgcVideo {
  id                     String    @id @default(cuid())
  /// Which workspace owns this row. Null = owned by Next5 (the admin lab's own videos).
  workspaceId            String?   @map("workspace_id")
  characterId            String?   @map("character_id")
  /// ai-character (image as look reference) | real-person (photo as first frame) | imported
  mode                   String
  script                 String
  prompt                 String    @default("")
  durationSec            Int       @map("duration_sec")
  resolution             String
  /// Which Treg route made it: openrouter | reapi. Older videos are all reapi.
  provider               String    @default("reapi")
  providerTaskId         String?   @unique @map("provider_task_id")
  /// generating | ready | failed
  status                 String    @default("generating")
  rawKey                 String?   @map("raw_key")
  captionedKey           String?   @map("captioned_key")
  transcript             String?
  error                  String?
  lastPollError          String?   @map("last_poll_error")
  estimatedCostUsdMicros Int       @default(0) @map("estimated_cost_usd_micros")
  /// Real cost from the provider (reapi usage.credits × 1000). 0 until the video finishes.
  costUsdMicros          Int       @default(0) @map("cost_usd_micros")
  /// Last status check that found the video still generating.
  lastCheckedAt          DateTime? @map("last_checked_at")
  /// Submit → finish. The provider gives no finish time, so this is the midpoint between the last
  /// "still generating" check and the first "done" check.
  generationSeconds      Int?      @map("generation_seconds")
  /// True when those two checks were at most 30 s apart — only precise timings feed wait estimates.
  timingPrecise          Boolean   @default(false) @map("timing_precise")
  submittedAt            DateTime? @map("submitted_at")
  completedAt            DateTime? @map("completed_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  character  UgcCharacter?    @relation(fields: [characterId], references: [id], onDelete: SetNull)
  workspace  Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  descriptor AssetDescriptor?

  @@index([createdAt])
  @@index([status])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("ugc_videos")
}

/// UGC Clone: one Seedance 2.5 face-swap video. Files live in R2; reapi CDN URLs are never stored.
model CloneVideo {
  id            String    @id @default(cuid())
  /// Which workspace owns this row. Null = owned by Next5 (the admin lab's own clones).
  workspaceId   String?   @map("workspace_id")
  poyoTaskId    String    @unique @map("poyo_task_id")
  characterKey  String    @map("character_key")
  refVideoKey   String    @map("ref_video_key")
  durationSec   Int       @map("duration_sec")
  /// generating | ready | failed
  status        String    @default("generating")
  /// R2 key for the mirrored output video (set when status = ready)
  rawKey        String?   @map("raw_key")
  error         String?
  costUsdMicros Int       @default(0) @map("cost_usd_micros")
  /// Seedance model used (e.g. doubao-seedance-2.5-face)
  model         String?
  /// Resolution (e.g. 480p)
  resolution    String?
  /// Prompt sent to Seedance
  prompt        String?
  submittedAt   DateTime? @map("submitted_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("clone_videos")
}

// ════════════════════════════════════════════════════════════════════════════
// Blitz Lab — low-cost UGC layer assembly (v0 feasibility)
// Spec: .cursor/plans/blitz_lab_feature_6763b082.plan.md
// ════════════════════════════════════════════════════════════════════════════

enum BlitzTemplateType {
  GREEN_SCREEN
  BROLL_VIDEO
  CAROUSEL

  @@map("blitz_template_type")
}

enum BlitzRenderStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("blitz_render_status")
}

/// Blitz Lab: a reusable composition template (GREEN_SCREEN only in v0).
model BlitzTemplate {
  id              String            @id @default(cuid())
  name            String
  type            BlitzTemplateType @default(GREEN_SCREEN)
  /// { backgroundKey, overlayKey, audioKey? } — R2 keys for default assets
  defaultAssets   Json              @map("default_assets")
  /// { font, positionY, fontSize, safeZonePadding }
  textConfig      Json              @map("text_config")
  defaultHookText String            @default("") @map("default_hook_text")
  remixPrompt     String            @default("") @map("remix_prompt")
  durationSeconds Float             @default(5.0) @map("duration_seconds")
  fps             Int               @default(30)
  createdAt       DateTime          @default(now()) @map("created_at")

  projects BlitzProject[]

  @@map("blitz_templates")
}

/// Blitz Lab: a single swappable asset in the asset library (manually seeded).
/// OVERLAY assets MUST be pre-keyed WebM (VP9 alpha) — no chroma-keying at render time.
model BlitzAsset {
  id           String   @id @default(cuid())
  /// Which workspace owns this asset. Null = the shared Next5 library every workspace sees.
  workspaceId  String?  @map("workspace_id")
  name         String
  /// "BACKGROUND" | "OVERLAY" | "AUDIO"
  type         String
  r2Key        String   @map("r2_key")
  thumbnailKey String?  @map("thumbnail_key")
  /// Flat tag list e.g. ["Activity", "Talking", "Emotion", "Happy"]
  tags         String[] @default([])
  /// "library" | "upload"
  source       String   @default("library")
  createdAt    DateTime @default(now()) @map("created_at")

  workspace  Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  descriptor AssetDescriptor?

  @@index([type])
  @@index([workspaceId, type])
  @@map("blitz_assets")
}

/// Blitz Lab: one editing session + its render result.
/// The "library" is the set of rows where renderStatus = COMPLETED.
model BlitzProject {
  id                   String            @id @default(cuid())
  /// Which workspace owns this render. Null = made in the admin lab by Next5.
  workspaceId          String?           @map("workspace_id")
  templateId           String            @map("template_id")
  template             BlitzTemplate     @relation(fields: [templateId], references: [id])
  workspace            Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// { backgroundKey, overlayKey, audioKey? }
  currentAssets        Json              @map("current_assets")
  overlayZoom          Float             @default(1.0) @map("overlay_zoom")
  overlayOffsetX       Float             @default(0) @map("overlay_offset_x")
  overlayOffsetY       Float             @default(0) @map("overlay_offset_y")
  mentionBusiness      Boolean           @default(false) @map("mention_business")
  regenPrompt          String?           @map("regen_prompt")
  captionText          String            @default("") @map("caption_text")
  renderStatus         BlitzRenderStatus @default(PENDING) @map("render_status")
  renderedVideoKey     String?           @map("rendered_video_key")
  /// Hard-blocks any future export path; set manually for real-person test footage.
  isIdentifiablePerson Boolean           @default(false) @map("is_identifiable_person")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  @@index([renderStatus])
  @@index([createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("blitz_projects")
}

/// AI-generated descriptor for a BlitzAsset or UgcVideo.
/// Produced by the blitz-worker descriptor loop: ffprobe/ffmpeg measurement → Gemini call → validated JSON.
/// Exactly one of blitzAssetId or ugcVideoId is set (enforced by DB CHECK constraint).
model AssetDescriptor {
  id                 String    @id @default(cuid())
  blitzAssetId       String?   @unique @map("blitz_asset_id")
  ugcVideoId         String?   @unique @map("ugc_video_id")
  workspaceId        String?   @map("workspace_id")
  /// 'meme' | 'ugc_video' | 'music' | 'background'
  kind               String
  /// 'scraped' | 'ai_generated' | 'uploaded' — propagated from the parent asset at enqueue time
  source             String?
  /// 'pending' | 'claimed' | 'done' | 'failed'
  status             String    @default("pending")
  attempts           Int       @default(0)
  claimedAt          DateTime? @map("claimed_at")
  error              String?
  /// Bumped each time the asset is re-described after a prompt improvement
  descriptorVersion  Int       @default(1) @map("descriptor_version")
  /// Model slug used to produce this descriptor, e.g. google/gemini-3.1-flash-lite
  model              String?
  /// Measured by ffprobe before the model call
  durationSec        Float?    @map("duration_sec")
  /// [{t: number}] — ffmpeg scene cut timestamps
  sceneCuts          Json?     @map("scene_cuts")
  /// [{t: number, lufs: number}] — ffmpeg loudness samples
  loudnessCurve      Json?     @map("loudness_curve")
  /// Full model output (raw)
  descriptor         Json?
  /// 1-2 sentence description for BM25 / semantic search
  retrievalText      String?   @map("retrieval_text")
  // ── Filter columns (NULL = unknown / not yet described) ─────────────────
  mood               String[]  @default([])
  pacing             String?
  hasSpeech          Boolean?  @map("has_speech")
  /// 'none' | 'low' | 'high' — NULL until status=done
  rightsRisk         String?   @map("rights_risk")
  /// NULL until status=done
  identifiablePerson  Boolean?  @map("identifiable_person")
  /// True if the person appears to be a well-known public figure (sets rightsRisk=high)
  publicFigureLikely  Boolean?  @map("public_figure_likely")
  avoidFor            String[]  @default([]) @map("avoid_for")
  energyLevel         Float?    @map("energy_level")
  /// 'none' | 'top_third' | 'bottom_third' | 'center'
  textSafeZone        String?   @map("text_safe_zone")
  /// Admin override for rights risk; wins over model value when not null
  rightsRiskOverride  String?   @map("rights_risk_override")
  /// DB-generated: COALESCE(rights_risk_override, rights_risk). Filter on this, never on rights_risk.
  /// Prisma maps this as read-only — never include it in create/update inputs.
  effectiveRightsRisk String?   @map("effective_rights_risk")
  /// LLM estimate of BPM (music only). Null = not described. Never used for timing.
  bpmEstimate         Float?    @map("bpm")
  // ── Per-role slot scores (0–1, NULL = not yet described) ────────────────
  slotHook           Float?    @map("slot_hook")
  slotProblem        Float?    @map("slot_problem")
  slotProof          Float?    @map("slot_proof")
  slotPayoff         Float?    @map("slot_payoff")
  slotCta            Float?    @map("slot_cta")
  // ── Niche fit scores ────────────────────────────────────────────────────
  nicheRealtor       Float?    @map("niche_realtor")
  nicheTiktokShop    Float?    @map("niche_tiktok_shop")

  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  blitzAsset BlitzAsset? @relation(fields: [blitzAssetId], references: [id], onDelete: Cascade)
  ugcVideo   UgcVideo?   @relation(fields: [ugcVideoId],   references: [id], onDelete: Cascade)
  workspace  Workspace?  @relation(fields: [workspaceId],  references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("asset_descriptors")
}

/// An Instagram or TikTok account a workspace connected in Settings > Integrations.
/// Tokens are encrypted by the app (src/server/social/crypto.ts).
model SocialConnection {
  id               String    @id @default(cuid())
  workspaceId      String    @map("workspace_id")
  /// instagram | tiktok
  provider         String
  externalId       String    @map("external_id")
  username         String?
  avatarUrl        String?   @map("avatar_url")
  accessToken      String    @map("access_token")
  refreshToken     String?   @map("refresh_token")
  expiresAt        DateTime? @map("expires_at")
  refreshExpiresAt DateTime? @map("refresh_expires_at")
  scopes           String[]  @default([])
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@map("social_connections")
}

/// One "Post now" from the calendar: where it went and what the platform answered.
model SocialPost {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  slotId      String?  @map("slot_id")
  provider    String
  /// sent | failed
  status      String
  externalId  String?  @map("external_id")
  postUrl     String?  @map("post_url")
  error       String?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  slot      PostSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("social_posts")
}

// ─── Phase 0B — Template Engine ──────────────────────────────────────────────
// The library the Campaign Wizard proposes from.
// Plan: docs/business-studios/phases/phase-0b-template-engine.md

/// Who the business sells to. Captured at signup step 2, editable on the Brand page.
enum AudienceType {
  b2c
  b2b
  both

  @@map("audience_type")
}

/// What a post is for. `interest` was dropped — no Phase 0A template carried it.
enum ContentPurpose {
  awareness
  trust
  enquiry
  conversion
  engagement
  retention

  @@map("content_purpose")
}

enum ContentTemplateStatus {
  draft
  active
  archived

  @@map("content_template_status")
}

enum AssetKind {
  person_on_camera
  product_footage
  product_image
  location_footage
  customer_photo
  customer_footage
  logo
  on_screen_text
  before_after_photo
  before_footage
  after_footage
  demonstration
  spec_sheet_broll
  trending_audio
  screen_recording
  generic_selfie

  @@map("asset_kind")
}

/// How an asset can be satisfied. `generate` = the UGC Lab can make it, so it never blocks
/// a campaign; `upload` is the only kind the business must supply itself.
enum AssetFulfilment {
  upload
  library
  generate

  @@map("asset_fulfilment")
}

enum TemplateVariableType {
  text
  image
  number
  url

  @@map("template_variable_type")
}

enum TemplateVariableSource {
  brand
  campaign
  manual

  @@map("template_variable_source")
}

model ContentPillar {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  templates ContentTemplate[]

  @@map("content_pillars")
}

model ContentTemplate {
  id         String @id @default(cuid())
  slug       String @unique
  /// 1..18 from Phase 0A. Kept so routes that pass a number keep resolving.
  legacyId   Int?   @map("legacy_id")
  name       String
  pillarId   String @map("pillar_id")
  /// Flat string, not a table: Phase 0A produced one format per template (decision B3).
  formatSlug String @map("format_slug")

  audience       AudienceType     @default(both)
  platforms      String[]         @default(["tiktok", "instagram"])
  purposes       ContentPurpose[]
  primaryPurpose ContentPurpose   @map("primary_purpose")

  /// null = global, owned by Next5. Set = an override cloned for one workspace.
  workspaceId      String? @map("workspace_id")
  parentTemplateId String? @map("parent_template_id")
  activeVersionId  String? @map("active_version_id")

  status ContentTemplateStatus @default(draft)

  /// Which engine should make this template's posts. Read by Phase 1B; tagged by hand before then.
  recommendedEngine ContentEngine @default(blitz_slideshow) @map("recommended_engine")

  /// Whether slides resolve variables from the business's own identity (business) or from audience
  /// personas and pain points (audience). Drives resolveVariables() in Campaign Studio.
  /// A new version never changes this; a format change in perspective becomes a new template.
  perspective TemplatePerspective @default(business) @map("perspective")

  /// Performance stubs — populated once publishing + analytics exist. Matching never reads them.
  timesUsed          Int    @default(0) @map("times_used")
  avgEngagementScore Float? @map("avg_engagement_score")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pillar        ContentPillar            @relation(fields: [pillarId], references: [id])
  workspace     Workspace?               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent        ContentTemplate?         @relation("TemplateOverride", fields: [parentTemplateId], references: [id], onDelete: SetNull)
  overrides     ContentTemplate[]        @relation("TemplateOverride")
  activeVersion ContentTemplateVersion?  @relation("ActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions      ContentTemplateVersion[] @relation("TemplateVersions")
  usages        TemplateUsage[]
  campaignPosts CampaignPost[]

  @@index([workspaceId, status])
  @@index([legacyId])
  @@map("content_templates")
}

/// Editing an active template writes a new version rather than mutating this one, so a plan
/// generated last week still reports exactly what it was generated from.
model ContentTemplateVersion {
  id              String   @id @default(cuid())
  templateId      String   @map("template_id")
  version         Int
  hookPattern     String   @default("") @map("hook_pattern")
  /// [{ label, guidance, bgPrompt? }] — the ordered structure beats.
  beats           Json     @default("[]")
  /// [{ text, bgPrompt }] — what the Blitz slideshow renders. Separate from beats because the
  /// 4–6 structure beats and the 3–4 rendered slides are not one-to-one.
  suggestedSlides Json     @default("[]") @map("suggested_slides")
  /// Hook keywords, used to match a researched TikTok to its template.
  keywords        String[] @default([])
  createdAt       DateTime @default(now()) @map("created_at")

  template          ContentTemplate            @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  activeForTemplate ContentTemplate[]          @relation("ActiveVersion")
  variables         TemplateVariable[]
  assetRequirements TemplateAssetRequirement[]
  usages            TemplateUsage[]
  campaignPosts     CampaignPost[]

  @@unique([templateId, version])
  @@map("content_template_versions")
}

model TemplateVariable {
  id           String                 @id @default(cuid())
  versionId    String                 @map("version_id")
  key          String
  label        String
  type         TemplateVariableType   @default(text)
  source       TemplateVariableSource @default(campaign)
  required     Boolean                @default(true)
  defaultValue String?                @map("default_value")
  /// The worked example from Phase 0A. Not a default — a hint for whoever fills the variable.
  hint         String?
  position     Int                    @default(0)

  version ContentTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, key])
  @@map("template_variables")
}

model TemplateAssetRequirement {
  id         String          @id @default(cuid())
  versionId  String          @map("version_id")
  kind       AssetKind
  required   Boolean         @default(true)
  minCount   Int             @default(1) @map("min_count")
  fulfilment AssetFulfilment @default(upload)
  notes      String?

  version ContentTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, kind])
  @@map("template_asset_requirements")
}

/// What was proposed to whom and when — the input to the "don't repeat a template two weeks
/// running" rule. Lives in Phase 0B so that rule is testable before Phase 1 exists.
model TemplateUsage {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  templateId  String         @map("template_id")
  versionId   String         @map("version_id")
  purpose     ContentPurpose
  plannedFor  DateTime       @map("planned_for")
  campaignId  String?        @map("campaign_id")
  createdAt   DateTime       @default(now()) @map("created_at")

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template  ContentTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version   ContentTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  campaign  Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([workspaceId, templateId, plannedFor])
  @@index([workspaceId, plannedFor])
  @@map("template_usages")
}

// ─── Phase 1A — Campaign Wizard ──────────────────────────────────────────────
// Plan: docs/business-studios/phases/phase-01-campaign-wizard.md

enum CampaignGoal {
  leads
  enquiries
  sell

  @@map("campaign_goal")
}

enum CampaignStatus {
  draft
  generated
  scheduled
  archived

  @@map("campaign_status")
}

/// Where a post's material comes from: her own, a mix, or generated for her.
enum ContentSource {
  real
  mix
  generated

  @@map("content_source")
}

/// Which engine should make this template's posts. Read by Phase 1B; tagged by hand before then.
enum ContentEngine {
  blitz_slideshow
  ugc_video

  @@map("content_engine")
}

/// Which angle a template is written from (Campaign Studio v1).
/// business = slides speak as/about the business.
/// audience = slides speak to/for the audience.
enum TemplatePerspective {
  business
  audience

  @@map("template_perspective")
}

/// A week (or four) of planned content. Phase 1A books the days and says what each one needs;
/// it generates nothing, so it costs nothing.
model Campaign {
  id          String       @id @default(cuid())
  workspaceId String       @map("workspace_id")
  goal        CampaignGoal
  /// What is being sold when the goal is `sell`. Shop has products, Brand may have a listing,
  /// a service business has neither and types `campaignSubject` instead.
  productId   String?      @map("product_id")
  listingId   String?      @map("listing_id")
  channels    String[]     @default(["tiktok"])

  /// Campaign-only overrides of Workspace.promoting / Workspace.offer. Never written back.
  campaignSubject String? @map("campaign_subject")
  campaignMessage String? @map("campaign_message")
  useBrandSubject Boolean @default(true) @map("use_brand_subject")
  useBrandMessage Boolean @default(true) @map("use_brand_message")

  promo String?
  notes String?

  postsPerDay Int      @default(1) @map("posts_per_day")
  weeks       Int      @default(1)
  startDate   DateTime @map("start_date") @db.Date

  assetMethod String? @map("asset_method")
  assetUrl    String? @map("asset_url")

  status CampaignStatus @default(draft)
  /// How far through the wizard she got, so a draft reopens where she left it.
  step   Int            @default(1)

  scheduledAt DateTime? @map("scheduled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  listing   Listing?        @relation(fields: [listingId], references: [id], onDelete: SetNull)
  posts     CampaignPost[]
  usages    TemplateUsage[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, status])
  @@map("campaigns")
}

/// One piece of content. The same content goes to every campaign channel, so one row here owns
/// one PostSlot per channel — posting can succeed on Instagram and fail on TikTok.
model CampaignPost {
  id           String         @id @default(cuid())
  campaignId   String         @map("campaign_id")
  dayIndex     Int            @map("day_index")
  slotOfDay    String         @default("evening") @map("slot_of_day")
  scheduledFor DateTime       @map("scheduled_for") @db.Date
  templateId   String         @map("template_id")
  /// Locked when the plan was proposed. Editing the template afterwards never changes this post.
  versionId    String         @map("version_id")
  purpose      ContentPurpose
  source       ContentSource  @default(real)
  /// True when the matcher had to relax the slot's purpose to fill it.
  widened      Boolean        @default(false)
  skipped      Boolean        @default(false)
  caption      String?
  position     Int            @default(0)
  createdAt    DateTime       @default(now()) @map("created_at")

  campaign Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  template ContentTemplate        @relation(fields: [templateId], references: [id])
  version  ContentTemplateVersion @relation(fields: [versionId], references: [id])
  slots    PostSlot[]

  @@index([campaignId, position])
  @@map("campaign_posts")
}

// ─── Campaign Studio v1 ───────────────────────────────────────────────────────
// Plan: docs/business-studios/campaign-studio-v1.md

/// Job execution state for long-running studio pipeline stages.
enum StudioJobStatus {
  idle
  pending
  running
  done
  failed

  @@map("studio_job_status")
}

/// Which pipeline step the run is currently on.
enum StudioStep {
  profile
  research
  generation
  calendar

  @@map("studio_step")
}

/// Why a research item was excluded from the run.
enum StudioExcludeReason {
  too_long
  no_hook
  unsupported_format

  @@map("studio_exclude_reason")
}

/// Admin's decision on a generated post candidate.
enum StudioCandidateStatus {
  pending
  accepted
  rejected
  edited

  @@map("studio_candidate_status")
}

/// Why a candidate was rejected.
enum StudioRejectReason {
  off_brand
  wrong_audience
  weak_hook
  bad_image
  factually_wrong
  other

  @@map("studio_reject_reason")
}

/// Type of entry in the shared research cache.
enum StudioCacheType {
  keyword
  transcript
  classification

  @@map("studio_cache_type")
}

/// One immutable snapshot of a client's brand profile.
/// Each edit inserts a new row (incremented version); candidates reference profileVersion so we
/// never lose the state that produced them.
model StudioBrandProfile {
  id          String  @id @default(cuid())
  workspaceId String? @map("workspace_id")
  sourceUrl   String  @map("source_url")
  version     Int     @default(1)

  /// Field-envelope JSON: { classification, identity, positioning, market, tone, visual }
  /// Each leaf: { value, source, confidence, evidence?, locked }
  data Json @default("{}")

  /// Per-stage telemetry: { stages: { crawl, infer, competitors, keywords }, totalDurationMs, totalCostUsdMicros }
  crawl Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  workspace Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      StudioRun[]

  @@index([workspaceId, sourceUrl, version(sort: Desc)])
  @@map("studio_brand_profiles")
}

/// One end-to-end campaign studio pipeline run (profile → research → generation → calendar).
model StudioRun {
  id             String  @id @default(cuid())
  workspaceId    String? @map("workspace_id")
  brandProfileId String  @map("brand_profile_id")

  step    StudioStep @default(profile)
  cadence Json       @default("{\"postsPerWeek\":3,\"weekdays\":[\"mon\",\"wed\",\"fri\"]}")

  extractStatus  StudioJobStatus @default(idle) @map("extract_status")
  extractError   String?         @map("extract_error")
  researchStatus StudioJobStatus @default(idle) @map("research_status")
  researchError  String?         @map("research_error")
  generateStatus StudioJobStatus @default(idle) @map("generate_status")
  generateError  String?         @map("generate_error")

  /// Wall-clock durations for each stage (ms).
  extractDurationMs  Int? @map("extract_duration_ms")
  researchDurationMs Int? @map("research_duration_ms")
  generateDurationMs Int? @map("generate_duration_ms")

  /// Cost accumulators per stage (micros of USD — same denomination as UgcVideo.costUsdMicros).
  extractCostUsdMicros  BigInt? @map("extract_cost_usd_micros")
  researchCostUsdMicros BigInt? @map("research_cost_usd_micros")

  createdBy String   @default("admin") @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace    Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandProfile StudioBrandProfile  @relation(fields: [brandProfileId], references: [id])
  items        StudioResearchItem[]
  candidates   StudioCandidate[]

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("studio_runs")
}

/// One TikTok video result stored for (or excluded from) a studio run.
model StudioResearchItem {
  id              String  @id @default(cuid())
  runId           String  @map("run_id")
  keyword         String
  sourceUrl       String  @map("source_url")
  author          String?
  durationSeconds Int?    @map("duration_seconds")

  stats   Json @default("{}")
  hook    String?
  transcript String?

  templateId String? @map("template_id")
  /// Resolved variables: { KEY: { value, source } }
  variables  Json    @default("{}")

  selected Boolean @default(false)
  excluded Boolean @default(false)
  excludedReason StudioExcludeReason? @map("excluded_reason")

  /// Telemetry
  fetchDurationMs         Int?    @map("fetch_duration_ms")
  transcriptCostUsdMicros BigInt? @map("transcript_cost_usd_micros")

  isCompetitor Boolean @default(false) @map("is_competitor")
  createdAt    DateTime @default(now()) @map("created_at")

  run StudioRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@map("studio_research_items")
}

/// One generated slideshow candidate awaiting swipe review.
model StudioCandidate {
  id             String  @id @default(cuid())
  runId          String  @map("run_id")
  researchItemId String? @map("research_item_id")
  engine         String  @default("blitz_slideshow")
  templateId     String? @map("template_id")
  angle          String?

  /// Full Blitz Slideshow payload — what gets sent to the worker on accept.
  payload Json @default("{}")

  /// Cost breakdown: { slideTextLlm, imageGeneration, totalUsdMicros }
  costBreakdown    Json    @default("{}") @map("cost_breakdown")
  costUsdMicros    BigInt? @map("cost_usd_micros")
  generateDurationMs Int?  @map("generate_duration_ms")

  /// Profile version this candidate was generated from.
  profileVersion Int @default(1) @map("profile_version")

  status       StudioCandidateStatus @default(pending)
  rejectReason StudioRejectReason?   @map("reject_reason")
  rejectNote   String?               @map("reject_note")

  /// Set on accept: the Blitz render job id.
  blitzProjectId String?   @map("blitz_project_id")
  /// Set after calendar slot assignment.
  slotDate       DateTime? @map("slot_date")

  /// Guardrail warnings: [{ type, text, rule }]
  guardrailWarnings Json @default("[]") @map("guardrail_warnings")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  run StudioRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@map("studio_candidates")
}

/// Shared keyword/transcript cache. Keyword entries expire after 7 days.
model StudioResearchCache {
  id        String           @id @default(cuid())
  cacheType StudioCacheType  @default(keyword) @map("cache_type")
  /// Normalized keyword (lower+trim) or video URL.
  cacheKey  String           @map("cache_key")
  data      Json             @default("{}")
  expiresAt DateTime         @map("expires_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@unique([cacheType, cacheKey])
  @@index([expiresAt])
  @@map("studio_research_cache")
}

{
  "framework": "nextjs",
  "regions": ["sin1"],
  "buildCommand": "bash scripts/vercel-build.sh",
  "installCommand": "npm ci",
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "functions": {
    "app/api/app/workspace/angles/generate/route.ts": {
      "maxDuration": 60
    },
    "app/api/generate/scene/route.ts": {
      "maxDuration": 120
    },
    "app/api/generate/route.ts": {
      "maxDuration": 120
    },
    "app/api/cron/billing-daily/route.ts": {
      "maxDuration": 60
    },
    "app/api/app/batches/[batchId]/zip/route.ts": {
      "maxDuration": 60
    },
    "app/api/admin/blueprint/days/[day]/script/route.ts": {
      "maxDuration": 120
    },
    "app/api/admin/blueprint/days/[day]/script/refine/route.ts": {
      "maxDuration": 120
    },
    "app/api/admin/blueprint/days/[day]/hooks/route.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron/billing-daily",
      "schedule": "0 1 * * *"
    }
  ]
}

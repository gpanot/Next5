# ── Vercel Production Environment Variables ───────────────────────────────────
# Set ALL of these in: vercel.com → next5 project → Settings → Environment Variables
# Target: Production (and optionally Preview)
#
# NEVER commit .env.local — it's gitignored. Use this file as the reference.

# ── Database (Railway PostgreSQL public proxy) ────────────────────────────────
# Railway dashboard → next5 project → Postgres → Variables → DATABASE_URL
# Append ?connection_limit=5&pool_timeout=30 to cap serverless connections.
DATABASE_URL=postgresql://postgres:<PASSWORD>@shinkansen.proxy.rlwy.net:41798/railway?connection_limit=5&pool_timeout=30

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=<generate with: openssl rand -base64 32>
ADMIN_SECRET=<strong password for /admin>

# ── App URL (your production domain) ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://next5-alpha.vercel.app

# ── Email (Maileroo) ─────────────────────────────────────────────────────────
# Maileroo dashboard → Applications → Next5 → Sending Key
# From address: noreply@mail.next5.giinger.com (verified domain)
SENDING_KEY=14ef21...

# ── WaveSpeed — AI image generation ──────────────────────────────────────────
WAVESPEED_API_KEY=wsk_live_...

# ── Cloudflare R2 — permanent photo storage ───────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=ad4032bd6fb0b9615025f106eb343024
R2_ACCESS_KEY_ID=<your R2 access key>
R2_SECRET_ACCESS_KEY=<your R2 secret key>
R2_BUCKET_NAME=next5-photos

# ── OpenAI — creative director notes ─────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ── DO NOT set in production ──────────────────────────────────────────────────
# NEXT5_MOCK_GENERATION=true   ← only for local dev, never on Vercel

# ── Business studios (Brand + Shop) ──────────────────────────────────────────
# Business routes (/brand /shop /pricing /start /app, /api/app/*) 404 unless true.
NEXT5_BUSINESS_ENABLED=false
# FX used to charge VND for USD prices (rounded up to 1,000₫).
VND_PER_USD=26000
# Payments are not live (decision D7). false (production default) → plan choices become early-access requests the admin activates;
# true → "Simulate transfer" button (free plans for anyone — testing only).
NEXT5_MOCK_PAYMENTS=false
# Receives an email for every early-access request (optional).
NEXT5_ADMIN_EMAIL=
# Demo bank details shown on the checkout sheet.
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# Max WaveSpeed tasks in flight across all batches.
GENERATION_MAX_CONCURRENT=6
# Business generation is driven by WaveSpeed webhooks (no generations cron). Signs callbacks to /api/webhooks/wavespeed;
# without it (or without an https NEXT_PUBLIC_APP_URL) no webhook is attached. Get it: GET https://api.wavespeed.ai/api/v3/webhook/secret
WAVESPEED_WEBHOOK_SECRET=
# Protects /api/cron/* (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=
# Object storage driver for business images: r2 (production default) | local (dev default).
NEXT5_STORAGE=r2

# ── TikTok Shop import (V1 scraper, decision D14) ─────────────────────────────
APIFY_TOKEN=
# Protects /api/webhooks/apify (?secret=…).
APIFY_WEBHOOK_SECRET=
# Max products pulled from TikTok per run. Keep at 10 while testing; raise to 500 for launch.
NEXT5_SHOP_IMPORT_MAX=10

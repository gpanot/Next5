# ── Vercel Production Environment Variables ───────────────────────────────────
# Set ALL of these in: vercel.com → next5 project → Settings → Environment Variables
# Target: Production (and optionally Preview)
#
# NEVER commit .env.local — it's gitignored. Use this file as the reference.

# ── Database (Railway PostgreSQL public proxy) ────────────────────────────────
# Railway dashboard → next5 project → Postgres → Variables → DATABASE_URL
# Append ?connection_limit=5&pool_timeout=30 to cap serverless connections.
DATABASE_URL=postgresql://postgres:<PASSWORD>@shinkansen.proxy.rlwy.net:41798/railway?connection_limit=5&pool_timeout=30

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=<generate with: openssl rand -base64 32>
ADMIN_SECRET=<strong password for /admin>

# ── App URL (your production domain) ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://next5-alpha.vercel.app

# ── Email (Maileroo) ─────────────────────────────────────────────────────────
# Maileroo dashboard → Applications → Next5 → Sending Key
# From address: noreply@mail.next5.giinger.com (verified domain)
SENDING_KEY=14ef21...

# ── WaveSpeed — AI image generation ──────────────────────────────────────────
WAVESPEED_API_KEY=wsk_live_...

# ── Cloudflare R2 — permanent photo storage ───────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=ad4032bd6fb0b9615025f106eb343024
R2_ACCESS_KEY_ID=<your R2 access key>
R2_SECRET_ACCESS_KEY=<your R2 secret key>
R2_BUCKET_NAME=next5-photos

# ── OpenAI — creative director notes ─────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...

# ── DO NOT set in production ──────────────────────────────────────────────────
# NEXT5_MOCK_GENERATION=true   ← only for local dev, never on Vercel
